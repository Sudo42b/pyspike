# and Makefile) so these fixtures and the build recipe land in the repo.
!nop_wjoin.elf
!mm_basic.elf
!activation_relu_gelu.elf
!Makefile

# Build artifacts from `make` other than nop_wjoin.elf:
*.o
*.tmp
